import { useState } from 'react';
// Importamos componentes de gráficos
import { 
  BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer,
  PieChart, Pie, Cell
} from 'recharts';

export default function ScoresApp() {
  const [input, setInput] = useState('');
  const [results, setResults] = useState([]);
  const [sortBy, setSortBy] = useState('order');
  const [showTopicWeights, setShowTopicWeights] = useState(false);
  const [showSentimentWeights, setShowSentimentWeights] = useState(false);
  const [isLoading, setIsLoading] = useState(false); // Nuevo estado para carga
  
  // Topic labels (19)
  const topicLabels = [
    'Arts & Culture',
    'Business & Entrepreneurs',
    'Celebrity & Pop Culture',
    'Diaries & Daily Life',
    'Family',
    'Fashion & Style',
    'Film TV & Video',
    'Fitness & Health',
    'Food & Dining',
    'Gaming',
    'Learning & Educational',
    'Music',
    'News & Social Concern',
    'Other Hobbies',
    'Relationships',
    'Science & Technology',
    'Sports',
    'Travel & Adventure',
    'Youth & Student Life'
];
  
  // Sentiment labels (6)
  const sentimentLabels = [
    'Tristeza', 'Alegria', 'Amor',
    'Ira', 'Miedo', 'Sorpresa'
  ];

  // Colores para las gráficas
  const COLORS = ['#0088FE', '#00C49F', '#FFBB28', '#FF8042', '#8884d8', '#82ca9d'];
  
  // Initialize weights to 1.0 for all labels
  const [topicWeights, setTopicWeights] = useState(
    Object.fromEntries(topicLabels.map((label, i) => [i, 1.0]))
  );
  const [sentimentWeights, setSentimentWeights] = useState(
    Object.fromEntries(sentimentLabels.map((label, i) => [i, 1.0]))
  );

  // Update weight handlers
  const updateTopicWeight = (index, value) => {
    setTopicWeights(prev => ({...prev, [index]: parseFloat(value) || 0}));
  };
  
  const updateSentimentWeight = (index, value) => {
    setSentimentWeights(prev => ({...prev, [index]: parseFloat(value) || 0}));
  };

  // Calculate weighted score
  const calculateWeightedScore = (result) => {
    let topicScore = 0;
    let sentimentScore = 0;
    
    // Topic scores (first 19)
    result.topic_scores.forEach((score, i) => {
      topicScore += score * (topicWeights[i] || 1.0);
    });
    
    // Sentiment scores (last 6)
    result.sentiment_scores.forEach((score, i) => {
      sentimentScore += score * (sentimentWeights[i] || 1.0);
    });
    
    return topicScore + sentimentScore;
  };

  // Función para procesar un solo texto (reutilizable)
  const fetchPrediction = async (text) => {
    const response = await fetch("http://127.0.0.1:8000/ai", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ text: text }),
    });
    if (!response.ok) throw new Error("Request failed");
    return await response.json();
  };

  // Llamada a la API (Individual)
  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!input.trim()) return;
    
    setIsLoading(true);
    try {
      const data = await fetchPrediction(input);
      setResults((prev) => [...prev, data]);
    } catch (err) {
      console.error("Error:", err);
      alert("Backend not reachable or error in response");
    } finally {
      setInput('');
      setIsLoading(false);
    }
  };

  // Manejo de Carga de Archivo (Dataset)
  const handleFileUpload = async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    setIsLoading(true);

    try {
      const text = await file.text();
      // Dividir por líneas y remover encabezado
      const lines = text.split('\n');
      
      // Filtrar líneas vacías y extraer mensajes
      // Formato: datetime_iso, date, time, user, message
      // El mensaje es la 5ta columna (índice 4), pero podría contener comas, así que tomamos todo después de la 4ta coma.
      const messages = lines.slice(1) // Ignorar header
        .map(line => {
          const parts = line.split(',');
          if (parts.length < 5) return null;
          // Unir todo a partir del índice 4 en caso de que el mensaje tenga comas
          return parts.slice(4).join(',').trim().replace(/^"|"$/g, ''); // Quitar comillas si es CSV estándar
        })
        .filter(msg => msg && msg.length > 0);

      // Aleatorizar (Fisher-Yates shuffle)
      for (let i = messages.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [messages[i], messages[j]] = [messages[j], messages[i]];
      }

      // Tomar muestra de 200
      const sample = messages.slice(0, 200);

      console.log(`Procesando ${sample.length} mensajes...`);

      // Procesar en paralelo
      const promises = sample.map(msg => fetchPrediction(msg).catch(e => null)); // Catch individual para no romper todo
      const batchResults = await Promise.all(promises);
      
      // Filtrar nulos (errores) y añadir al estado
      const validResults = batchResults.filter(r => r !== null);
      setResults(prev => [...prev, ...validResults]);
      
      alert(`Procesados ${validResults.length} mensajes exitosamente.`);

    } catch (err) {
      console.error("Error procesando archivo:", err);
      alert("Error al leer el archivo o conectar con el servidor.");
    } finally {
      setIsLoading(false);
      // Resetear el input file para permitir subir el mismo archivo de nuevo si se desea
      e.target.value = null; 
    }
  };

  // sort
  const getSortedResults = () => {
    const sorted = [...results];
    
    if (sortBy === 'order') {
      return sorted;
    } else if (sortBy === 'weighted') {
      return sorted.sort((a, b) => calculateWeightedScore(b) - calculateWeightedScore(a));
    } else if (sortBy.startsWith('topic-')) {
      const index = parseInt(sortBy.split('-')[1]);
      return sorted.sort((a, b) => {
        const scoreA = a.topic_scores[index] ?? 0;
        const scoreB = b.topic_scores[index] ?? 0;
        return scoreB - scoreA;
      });
    } else if (sortBy.startsWith('sentiment-')) {
      const index = parseInt(sortBy.split('-')[1]);
      return sorted.sort((a, b) => {
        const scoreA = a.sentiment_scores[index] ?? 0;
        const scoreB = b.sentiment_scores[index] ?? 0;
        return scoreB - scoreA;
      });
    }
    
    return sorted;
  };

  const sortedResults = getSortedResults();

  // Calcular datos para gráficas
  const getChartData = () => {
    if (results.length === 0) return { topics: [], sentiments: [] };

    // Contar cuántas veces cada tópico fue el #1
    const topicCounts = Array(topicLabels.length).fill(0);
    const sentimentCounts = Array(sentimentLabels.length).fill(0);

    results.forEach(res => {
      // Top Topic
      const topTopicIdx = res.topic_scores.indexOf(Math.max(...res.topic_scores));
      topicCounts[topTopicIdx]++;

      // Top Sentiment
      const topSentIdx = res.sentiment_scores.indexOf(Math.max(...res.sentiment_scores));
      sentimentCounts[topSentIdx]++;
    });

    const topicData = topicLabels.map((label, i) => ({
      name: label,
      count: topicCounts[i]
    })).filter(d => d.count > 0).sort((a, b) => b.count - a.count); // Solo mostrar los que tienen datos

    const sentimentData = sentimentLabels.map((label, i) => ({
      name: label,
      count: sentimentCounts[i]
    }));

    return { topicData, sentimentData };
  };

  const { topicData, sentimentData } = getChartData();

  return (
    <div>
      <div>
        <div className="Headers">
          <div><h1>Categorizacion de Topicos por BiLSTM</h1><br /></div>
          <div><h2>V1.0 : Categorizacion de Posts <strong> Positivos y Negativos</strong></h2><br /></div>
          <div className="postContainer" id="title">
            Por : <br/>
            Eli Dominguez <br/>
            Alejandra Dominguez <br/>
            Alan Leon <br/>
          </div>
        </div>

        {/* Input Area */}
        <div className="inputPost" style={{flexDirection: 'column', gap: '15px'}}>
          {/* Manual Input */}
          <div style={{display: 'flex', width: '100%', gap: '10px'}}>
            <input
              type="text"
              value={input}
              disabled={isLoading}
              onChange={(e) => setInput(e.target.value)}
              onKeyPress={(e) => e.key === 'Enter' && handleSubmit(e)}
              placeholder="Escribe el nuevo post..."
            />
            <button onClick={handleSubmit} disabled={isLoading}>
              {isLoading ? '...' : 'Procesar'}
            </button>
          </div>

          {/* CSV Upload */}
          <div style={{
            display: 'flex', 
            alignItems: 'center', 
            gap: '10px', 
            background: '#f8f9fa', 
            padding: '10px', 
            borderRadius: '8px',
            border: '1px dashed #ccc'
          }}>
            <span style={{fontWeight: 'bold', fontSize: '14px'}}>Cargar Dataset (CSV):</span>
            <input 
              type="file" 
              accept=".csv"
              onChange={handleFileUpload}
              disabled={isLoading}
              style={{fontSize: '14px'}}
            />
            {isLoading && <span style={{color: '#0066cc', fontWeight: 'bold'}}>Procesando muestra aleatoria... Por favor espere.</span>}
          </div>
        </div>

        {/* Graphs Section */}
        {results.length > 0 && (
          <div className="postContainer" style={{flexDirection: 'column', marginTop: '20px'}}>
            <h3 style={{marginBottom: '20px'}}>Estadísticas de Resultados ({results.length} posts)</h3>
            
            <div style={{display: 'flex', flexWrap: 'wrap', width: '100%', gap: '20px'}}>
              {/* Gráfica de Tópicos */}
              <div style={{flex: '1 1 500px', height: '300px'}}>
                <h4 style={{textAlign: 'center'}}>Distribución de Tópicos Dominantes</h4>
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={topicData} margin={{top: 5, right: 30, left: 20, bottom: 50}}>
                    <CartesianGrid strokeDasharray="3 3" />
                    <XAxis dataKey="name" angle={-45} textAnchor="end" interval={0} height={80} style={{fontSize: '10px'}}/>
                    <YAxis />
                    <Tooltip />
                    <Bar dataKey="count" fill="#8884d8" name="Cantidad de Posts" />
                  </BarChart>
                </ResponsiveContainer>
              </div>

              {/* Gráfica de Sentimientos */}
              <div style={{flex: '1 1 300px', height: '300px'}}>
                <h4 style={{textAlign: 'center'}}>Distribución de Sentimientos</h4>
                <ResponsiveContainer width="100%" height="100%">
                  <PieChart>
                    <Pie
                      data={sentimentData}
                      cx="50%"
                      cy="50%"
                      labelLine={false}
                      label={({ name, percent }) => percent > 0 ? `${name} ${(percent * 100).toFixed(0)}%` : ''}
                      outerRadius={80}
                      fill="#8884d8"
                      dataKey="count"
                    >
                      {sentimentData.map((entry, index) => (
                        <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                      ))}
                    </Pie>
                    <Tooltip />
                  </PieChart>
                </ResponsiveContainer>
              </div>
            </div>
          </div>
        )}

        {/* Existing Filters and Lists */}
        {results.length > 0 && (
          <div>
            <div className="inputPost" style={{marginTop: '20px'}}>
              <label>Ordenar por:</label>
              <select
                value={sortBy}
                onChange={(e) => setSortBy(e.target.value)}
              >
                <option value="order">First-Come-First-Served</option>
                <option value="weighted">Por Puntaje Ponderado</option>
                <optgroup label="Topics">
                  {topicLabels.map((label, i) => (
                    <option key={i} value={`topic-${i}`}>Por {label}</option>
                  ))}
                </optgroup>
                <optgroup label="Sentiments">
                  {sentimentLabels.map((label, i) => (
                    <option key={i} value={`sentiment-${i}`}>Por {label}</option>
                  ))}
                </optgroup>
              </select>
            </div>

            {/* Weights Controls (unchanged logic) */}
            <div className="inputPost" style={{marginTop: '10px'}}>
              <button 
                onClick={() => setShowTopicWeights(!showTopicWeights)}
                style={{
                  background: 'none',
                  border: 'none',
                  cursor: 'pointer',
                  fontSize: '16px',
                  fontWeight: 'bold',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '8px'
                }}
              >
                <span style={{transform: showTopicWeights ? 'rotate(90deg)' : 'rotate(0deg)', transition: 'transform 0.2s'}}>
                  ▶
                </span>
                Pesos de Topics
              </button>
              {showTopicWeights && (
                <div style={{
                  marginTop: '10px',
                  padding: '15px',
                  background: '#f5f5f5',
                  borderRadius: '8px',
                  display: 'grid',
                  gridTemplateColumns: 'repeat(auto-fill, minmax(200px, 1fr))',
                  gap: '10px'
                }}>
                  {topicLabels.map((label, i) => (
                    <div key={i} style={{display: 'flex', flexDirection: 'column', gap: '4px'}}>
                      <label style={{fontSize: '12px', fontWeight: 'bold'}}>{label}</label>
                      <input
                        type="number"
                        step="0.1"
                        min="0"
                        value={topicWeights[i]}
                        onChange={(e) => updateTopicWeight(i, e.target.value)}
                        style={{padding: '4px', fontSize: '14px'}}
                      />
                    </div>
                  ))}
                </div>
              )}
            </div>

            <div className="inputPost" style={{marginTop: '10px'}}>
              <button 
                onClick={() => setShowSentimentWeights(!showSentimentWeights)}
                style={{
                  background: 'none',
                  border: 'none',
                  cursor: 'pointer',
                  fontSize: '16px',
                  fontWeight: 'bold',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '8px'
                }}
              >
                <span style={{transform: showSentimentWeights ? 'rotate(90deg)' : 'rotate(0deg)', transition: 'transform 0.2s'}}>
                  ▶
                </span>
                Pesos de Sentimientos
              </button>
              {showSentimentWeights && (
                <div style={{
                  marginTop: '10px',
                  padding: '15px',
                  background: '#f5f5f5',
                  borderRadius: '8px',
                  display: 'grid',
                  gridTemplateColumns: 'repeat(auto-fill, minmax(200px, 1fr))',
                  gap: '10px'
                }}>
                  {sentimentLabels.map((label, i) => (
                    <div key={i} style={{display: 'flex', flexDirection: 'column', gap: '4px'}}>
                      <label style={{fontSize: '12px', fontWeight: 'bold'}}>{label}</label>
                      <input
                        type="number"
                        step="0.1"
                        min="0"
                        value={sentimentWeights[i]}
                        onChange={(e) => updateSentimentWeight(i, e.target.value)}
                        style={{padding: '4px', fontSize: '14px'}}
                      />
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        )}

        <div>
          {sortedResults.length === 0 ? (
            <div className="postContainer" style={{marginTop : '20px'}}>
              <div className="postText"> Agrega una publicación o sube un CSV para que el modelo lo valore </div>
            </div>
          ) : (
            sortedResults.map((result, idx) => {
              const topScore = Math.max(...result.topic_scores);
              const topTopicIndex = result.topic_scores.indexOf(topScore);
              
              const topSentimentScore = Math.max(...result.sentiment_scores);
              const topSentimentIndex = result.sentiment_scores.indexOf(topSentimentScore);
              
              return (
                <div className="postContainer"
                  key={idx} // Cambiado a idx porque timestamp puede repetirse en cargas batch rápidas
                  style={{
                    transform: 'translateY(0)',
                    opacity: 1
                  }}
                >
                  <div className="postText">
                    <div>
                      <h3>Input: {result.input}</h3>
                      {/* Solo mostramos fecha si existe, el batch crea fechas nuevas en el backend generalmente */}
                      <p style={{fontSize: '0.8em', color: '#666'}}>
                        Processed: {result.timestamp ? new Date(result.timestamp).toLocaleTimeString() : 'Just now'}
                      </p>
                      <p style={{marginTop: '10px', fontWeight: 'bold'}}>
                        Top Topic: {topicLabels[topTopicIndex]} ({(topScore * 100).toFixed(1)}%)
                      </p>
                      <p style={{fontWeight: 'bold'}}>
                        Top Sentiment: {sentimentLabels[topSentimentIndex]} ({(topSentimentScore * 100).toFixed(1)}%)
                      </p>
                      {sortBy === 'weighted' && (
                        <p style={{fontWeight: 'bold', color: '#0066cc'}}>
                          Weighted Score: {calculateWeightedScore(result).toFixed(2)}
                        </p>
                      )}
                    </div>
                  </div>
                  
                  <div className="postText">
                    <details style={{marginTop: '10px'}}>
                      <summary style={{cursor: 'pointer', fontWeight: 'bold'}}>Ver todos los puntajes de Topics</summary>
                      <div style={{marginTop: '10px', display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '8px'}}>
                        {result.topic_scores.map((score, i) => (
                          <div key={i} style={{
                            padding: '8px',
                            background: i === topTopicIndex ? '#e3f2fd' : '#f5f5f5',
                            borderRadius: '4px',
                            fontSize: '14px'
                          }}>
                            <strong>{topicLabels[i]}:</strong> {(score * 100).toFixed(1)}%
                          </div>
                        ))}
                      </div>
                    </details>
                    
                    <details style={{marginTop: '10px'}}>
                      <summary style={{cursor: 'pointer', fontWeight: 'bold'}}>Ver todos los puntajes de Sentimientos</summary>
                      <div style={{marginTop: '10px', display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '8px'}}>
                        {result.sentiment_scores.map((score, i) => (
                          <div key={i} style={{
                            padding: '8px',
                            background: i === topSentimentIndex ? '#e8f5e9' : '#f5f5f5',
                            borderRadius: '4px',
                            fontSize: '14px'
                          }}>
                            <strong>{sentimentLabels[i]}:</strong> {(score * 100).toFixed(1)}%
                          </div>
                        ))}
                      </div>
                    </details>
                  </div>
                </div>
              );
            })
          )}
        </div>
      </div>
    </div>
  );
}